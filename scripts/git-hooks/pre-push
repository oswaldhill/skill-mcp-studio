#!/bin/sh
# pre-push hook：门禁 —— 默认拦截推送到 GitHub 的请求。
#
# 规则：除非调用时显式设置 GITHUB_PUSH_ALLOW=1，否则拒绝任何推送到 github remote
# （remote 名为 github，或目标 URL 含 github.com）的操作。
#
# 放行示例（仅在用户明确要求提交 GitHub 时使用）：
#   GITHUB_PUSH_ALLOW=1 git push github master
#
# 本 hook 安装在 .git/hooks/pre-push，不随仓库提交。

remote_name="$1"
remote_url="$2"

if [ "$remote_name" = "github" ] || echo "$remote_url" | grep -qi "github.com"; then
    if [ "$GITHUB_PUSH_ALLOW" = "1" ]; then
        echo "[门禁] 已放行推送到 GitHub（GITHUB_PUSH_ALLOW=1）。"
        exit 0
    fi
    echo "" >&2
    echo "⛔ 门禁拦截：检测到推送到 GitHub 的请求。" >&2
    echo "   remote=$remote_name  url=$remote_url" >&2
    echo "" >&2
    echo "   按当前约定，只有在你明确要求时才允许提交 GitHub。" >&2
    echo "   如需放行本次推送，请使用：" >&2
    echo "     GITHUB_PUSH_ALLOW=1 git push github <branch>" >&2
    echo "" >&2
    exit 1
fi

exit 0