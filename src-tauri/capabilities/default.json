  "identifier": "default",
  "description": "Default capability for the Skill MCP Studio app",
  "windows": ["main", "popover"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:default",
    "dialog:allow-open"
  ]
}
